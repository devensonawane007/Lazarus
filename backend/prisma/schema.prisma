// Prisma schema for Lazarus V3 — Hosted PostgreSQL (Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// USER & ROLE MODELS
// -------------------------------------------------------------

enum Role {
  CREATOR
  BRAND
  INVESTOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CREATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creatorProfile      CreatorProfile?
  brandProfile        BrandProfile?
  investorProfile     InvestorProfile?
  investments         Investment[]
  escrowTransactions  EscrowTransaction[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@map("users")
}

model CreatorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  niches       String[] @default([])
  platform     String   @default("youtube")
  portfolioUrl String?
  followers    String?
  avgViews     String?
  isMouSigned  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects         Project[]
  applications     CampaignApplication[]
  mous             MOUAgreement[]
  submissions      Submission[]
  socialAccounts   SocialAccount[]
  contents         CreatorContent[]
  metricSnapshots  CreatorMetricSnapshot[]
  collaborations   Collaboration[]

  @@map("creator_profiles")
}

model BrandProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  industry    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns      Campaign[]
  collaborations Collaboration[]

  @@map("brand_profiles")
}

model InvestorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  String?
  totalInvested Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("investor_profiles")
}

model MOUAgreement {
  id               String         @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  documentTitle    String         @default("Agentic AI Creator MOU Agreement")
  signatureData    String         @db.Text
  signedAt         DateTime       @default(now())

  @@map("mou_agreements")
}

// -------------------------------------------------------------
// PROJECT, EXPENSE & MILESTONE MODELS (Retained for Compatibility)
// -------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  FUNDING
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  DISPUTED
}

model Project {
  id               String        @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String        @db.Text
  videoType        String        @default("general")
  fundingTarget    Float
  amountRaised     Float         @default(0)
  upfrontRatio     Float         @default(0.30)
  status           ProjectStatus @default(FUNDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  expenses           ExpenseItem[]
  milestones         Milestone[]
  investments        Investment[]
  escrowTransactions EscrowTransaction[]

  @@map("projects")
}

model ExpenseItem {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        String
  allocatedAmount Float?
  description     String?
  createdAt       DateTime @default(now())

  @@map("expense_items")
}

enum MilestoneStatus {
  PENDING
  HELD
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
  REFUNDED
}

model Milestone {
  id            String          @id @default(uuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?         @db.Text
  targetAmount  Float
  sequenceOrder Int             @default(1)
  status        MilestoneStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  submissions        Submission[]
  escrowTransactions EscrowTransaction[]

  @@map("milestones")
}

// -------------------------------------------------------------
// SUBMISSIONS & REVIEWS
// -------------------------------------------------------------

enum SubmissionStatus {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model Submission {
  id               String           @id @default(uuid())
  milestoneId      String
  milestone        Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  assetUrl         String           @db.Text
  notes            String?          @db.Text
  status           SubmissionStatus @default(SUBMITTED)
  reviewerFeedback String?          @db.Text
  submittedAt      DateTime         @default(now())
  reviewedAt       DateTime?

  @@map("submissions")
}

// -------------------------------------------------------------
// INVESTMENTS & ESCROW STATE MACHINE
// -------------------------------------------------------------

enum InvestmentStatus {
  COMMITTED
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
}

model Investment {
  id         String           @id @default(uuid())
  investorId String
  investor   User             @relation(fields: [investorId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount     Float
  status     InvestmentStatus @default(HELD_IN_ESCROW)
  createdAt  DateTime         @default(now())

  escrowTransactions EscrowTransaction[]

  @@map("investments")
}

enum EscrowTxnType {
  DEPOSIT
  HOLD
  RELEASE
  REFUND
  DISPUTE
}

enum EscrowTxnStatus {
  PENDING
  COMPLETED
  FAILED
}

model EscrowTransaction {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  investmentId String?
  investment   Investment?     @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float
  type         EscrowTxnType
  status       EscrowTxnStatus @default(COMPLETED)
  externalTxnId String?
  note         String?
  createdAt    DateTime        @default(now())

  @@map("escrow_transactions")
}

// -------------------------------------------------------------
// BRAND CAMPAIGNS & MATCHING
// -------------------------------------------------------------

enum CampaignStatus {
  OPEN
  ACTIVE
  COMPLETED
  CLOSED
}

model Campaign {
  id                 String         @id @default(uuid())
  brandProfileId     String
  brandProfile       BrandProfile   @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String         @db.Text
  niches             String[]       @default([])
  targetPlatforms    String[]       @default([])
  minFollowers       Int?           @default(0)
  minEngagementRate  Float?         @default(0.0)
  budget             Float
  deliverables       String         @db.Text
  status             CampaignStatus @default(OPEN)
  deadline           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  applications   CampaignApplication[]
  collaborations Collaboration[]

  @@map("campaigns")
}

enum ApplicationStatus {
  APPLIED
  ACCEPTED
  REJECTED
}

model CampaignApplication {
  id               String            @id @default(uuid())
  campaignId       String
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  status           ApplicationStatus @default(APPLIED)
  pitch            String?           @db.Text
  appliedAt        DateTime          @default(now())
  reviewedAt       DateTime?

  @@unique([campaignId, creatorProfileId])
  @@map("campaign_applications")
}

// -------------------------------------------------------------
// LAZARUS V3: SOCIAL MEDIA INTEGRATIONS & VERIFIED METRICS
// -------------------------------------------------------------

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  TWITCH
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  SYNC_FAILED
  SYNC_PENDING
  AWAITING_APPROVAL
  DISCONNECTED
}

model SocialAccount {
  id                String           @id @default(uuid())
  creatorProfileId  String
  creatorProfile    CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  platformAccountId String
  username          String
  displayName       String
  avatarUrl         String?
  profileUrl        String?
  status            ConnectionStatus @default(CONNECTED)
  scopes            String[]         @default([])
  lastSyncedAt      DateTime?
  syncError         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  credential        SocialCredential?

  @@unique([creatorProfileId, platform, platformAccountId])
  @@map("social_accounts")
}

model SocialCredential {
  id                    String        @id @default(uuid())
  socialAccountId       String        @unique
  socialAccount         SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String        @db.Text
  encryptedRefreshToken String?       @db.Text
  tokenExpiresAt        DateTime?
  iv                    String
  tag                   String
  updatedAt             DateTime      @updatedAt

  @@map("social_credentials")
}

model CreatorContent {
  id                String         @id @default(uuid())
  creatorProfileId  String
  creatorProfile    CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  externalContentId String
  title             String
  description       String?        @db.Text
  thumbnailUrl      String?
  contentUrl        String
  publishedAt       DateTime
  viewCount         Int            @default(0)
  likeCount         Int            @default(0)
  commentCount      Int            @default(0)
  metricsJson       Json?
  createdAt         DateTime       @default(now())

  @@unique([creatorProfileId, platform, externalContentId])
  @@map("creator_contents")
}

model CreatorMetricSnapshot {
  id               String         @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  platform         SocialPlatform
  followerCount    Int            @default(0)
  totalViews       BigInt         @default(0)
  engagementRate   Float          @default(0.0)
  watchTimeMinutes Float?
  snapshotDate     DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@map("creator_metric_snapshots")
}

// -------------------------------------------------------------
// LAZARUS V3: EXTENDED COLLABORATION LIFECYCLE
// -------------------------------------------------------------

enum CollaborationStatus {
  DISCOVERED
  APPLIED
  SHORTLISTED
  NEGOTIATION
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model Collaboration {
  id               String              @id @default(uuid())
  campaignId       String
  campaign         Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile      @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  brandProfileId   String
  brandProfile     BrandProfile        @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  status           CollaborationStatus @default(APPLIED)
  agreedAmount     Float
  currency         String              @default("INR")
  deliverableTerms String?             @db.Text
  startDate        DateTime?
  deadline         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  deliverables     CollaborationDeliverable[]

  @@unique([campaignId, creatorProfileId])
  @@map("collaborations")
}

model CollaborationDeliverable {
  id              String            @id @default(uuid())
  collaborationId String
  collaboration   Collaboration     @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  title           String
  description     String?           @db.Text
  platform        SocialPlatform?
  dueDate         DateTime?
  status          DeliverableStatus @default(PENDING)
  submissionUrl   String?
  notes           String?           @db.Text
  brandFeedback   String?           @db.Text
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("collaboration_deliverables")
}

// -------------------------------------------------------------
// LAZARUS V3: NOTIFICATIONS & AUDIT TRAIL
// -------------------------------------------------------------

enum NotificationType {
  CAMPAIGN_MATCH
  APPLICATION_STATUS
  COLLABORATION_UPDATE
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  SYNC_FAILURE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  detailsJson  Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}
